server:
  address: ":8801"
  read_timeout_seconds: 10
  write_timeout_seconds: 10

auth:
  enabled: true
  token: "change-me"

channels:
  jenkins-test:
    platform: "feishu"
    webhook: "https://open.feishu.cn/open-apis/bot/v2/hook/example"
    secret: "SECexample"
    template: "jenkins_feishu"
    at: []

  jenkins-prod:
    platform: "dingtalk"
    webhook: "https://oapi.dingtalk.com/robot/send?access_token=example"
    secret: "SECexample"
    template: "jenkins_dingtalk"
    at: []

  alert-prod:
    platform: "dingtalk"
    webhook: "https://oapi.dingtalk.com/robot/send?access_token=example"
    secret: "SECexample"
    template: "alertmanager_dingtalk"
    at: []
